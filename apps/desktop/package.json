{
  "name": "@quanti/desktop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "dev": "vite",
    "tauri": "tauri",
    "tauri:build": "node ../../scripts/prepare-autonomous-runtime.mjs && tauri build --config src-tauri/tauri.autonomous.conf.json",
    "tauri:build:debug": "tauri build --debug",
    "tauri:check": "cargo check --manifest-path src-tauri/Cargo.toml",
    "tauri:test": "cargo test --manifest-path src-tauri/Cargo.toml",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run && node --test test/**/*.test.mjs",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@quanti/shared": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react-swc": "^4.3.1",
    "jsdom": "^29.1.1",
    "sass": "^1.100.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
