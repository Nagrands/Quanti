{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "paths": {
      "@quanti/shared": ["./packages/shared/src/index.ts"],
      "@quanti/shared/*": ["./packages/shared/src/*"],
      "@quanti/db": ["./packages/db/src/index.ts"],
      "@quanti/db/*": ["./packages/db/src/*"]
    }
  }
}
