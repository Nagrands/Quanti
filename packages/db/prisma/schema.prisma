generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum CounterpartyType {
  CUSTOMER
  SUPPLIER
  BOTH
  INTERNAL
}

enum DocumentType {
  SALE
  PURCHASE
  TRANSFER
  STOCK_ADJUSTMENT
  RETURN_IN
  RETURN_OUT
}

enum DocumentStatus {
  DRAFT
  POSTED
}

enum StockMovementDirection {
  IN
  OUT
}

enum AccountType {
  CASH
  BANK
}

enum PaymentDirection {
  INCOMING
  OUTGOING
}

enum PaymentStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum MoneyMovementDirection {
  IN
  OUT
}

enum AuditEntityType {
  PRODUCT
  WAREHOUSE
  COUNTERPARTY
  DOCUMENT
  PAYMENT
  ACCOUNT
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  POST
  UNPOST
}

enum PrintTemplateScope {
  DOCUMENT
}

model Product {
  id             String          @id @default(cuid())
  sku            String          @unique
  name           String
  description    String?
  unit           String
  purchasePrice  BigInt?
  salePrice      BigInt?
  categoryId     String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  category       ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  aliases        ProductAlias[]
  units          ProductUnit[]
  documentItems  DocumentItem[]
  stockMovements StockMovement[]
  stockBalances  StockBalance[]

  @@index([categoryId])
}

model ProductAlias {
  id             String   @id @default(cuid())
  productId      String
  name           String
  normalizedName String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  product        Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductUnit {
  id               String   @id @default(cuid())
  productId        String
  name             String
  conversionFactor BigInt
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  product          Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name])
  @@index([productId])
}

model ProductCategory {
  id          String    @id @default(cuid())
  code        String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Warehouse {
  id                      String          @id @default(cuid())
  code                    String          @unique
  name                    String
  isActive                Boolean         @default(true)
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  documents               Document[]      @relation("DocumentWarehouse")
  sourceTransferDocs      Document[]      @relation("DocumentSourceWarehouse")
  destinationTransferDocs Document[]      @relation("DocumentDestinationWarehouse")
  stockMovements          StockMovement[]
  stockBalances           StockBalance[]
}

model Counterparty {
  id             String           @id @default(cuid())
  code           String           @unique
  name           String
  type           CounterpartyType
  taxId          String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  documents      Document[]
  payments       Payment[]
  moneyMovements MoneyMovement[]
}

model Document {
  id                     String              @id @default(cuid())
  number                 String              @unique
  type                   DocumentType
  status                 DocumentStatus      @default(DRAFT)
  documentDate           DateTime
  postedAt               DateTime?
  notes                  String?
  totalAmount            BigInt
  warehouseId            String?
  sourceWarehouseId      String?
  destinationWarehouseId String?
  counterpartyId         String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  warehouse              Warehouse?          @relation("DocumentWarehouse", fields: [warehouseId], references: [id])
  sourceWarehouse        Warehouse?          @relation("DocumentSourceWarehouse", fields: [sourceWarehouseId], references: [id])
  destinationWarehouse   Warehouse?          @relation("DocumentDestinationWarehouse", fields: [destinationWarehouseId], references: [id])
  counterparty           Counterparty?       @relation(fields: [counterpartyId], references: [id])
  items                  DocumentItem[]
  stockMovements         StockMovement[]
  paymentAllocations     PaymentAllocation[]

  @@index([type, status, documentDate])
  @@index([counterpartyId, documentDate])
}

model DocumentItem {
  id             String          @id @default(cuid())
  documentId     String
  productId      String
  unit           String
  unitFactor     BigInt
  lineNo         Int
  quantity       BigInt
  price          BigInt
  amount         BigInt
  warehouseId    String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  document       Document        @relation(fields: [documentId], references: [id], onDelete: Cascade)
  product        Product         @relation(fields: [productId], references: [id])
  stockMovements StockMovement[]

  @@unique([documentId, lineNo])
  @@index([productId])
}

model StockMovement {
  id             String                 @id @default(cuid())
  movementDate   DateTime
  direction      StockMovementDirection
  quantity       BigInt
  productId      String
  warehouseId    String
  documentId     String
  documentItemId String?
  createdAt      DateTime               @default(now())
  product        Product                @relation(fields: [productId], references: [id])
  warehouse      Warehouse              @relation(fields: [warehouseId], references: [id])
  document       Document               @relation(fields: [documentId], references: [id], onDelete: Cascade)
  documentItem   DocumentItem?          @relation(fields: [documentItemId], references: [id])

  @@index([productId, warehouseId, movementDate])
  @@index([documentId])
}

model StockBalance {
  id          String    @id @default(cuid())
  productId   String
  warehouseId String
  balanceDate DateTime
  quantity    BigInt
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  product     Product   @relation(fields: [productId], references: [id])
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([productId, warehouseId, balanceDate])
}

model Account {
  id             String          @id @default(cuid())
  code           String          @unique
  name           String
  type           AccountType
  currencyCode   String          @default("RUB")
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  payments       Payment[]
  moneyMovements MoneyMovement[]
}

model Payment {
  id             String              @id @default(cuid())
  number         String              @unique
  direction      PaymentDirection
  status         PaymentStatus       @default(DRAFT)
  paymentDate    DateTime
  amount         BigInt
  notes          String?
  accountId      String
  counterpartyId String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt
  account        Account             @relation(fields: [accountId], references: [id])
  counterparty   Counterparty?       @relation(fields: [counterpartyId], references: [id])
  allocations    PaymentAllocation[]
  moneyMovements MoneyMovement[]

  @@index([accountId, paymentDate])
  @@index([counterpartyId, paymentDate])
}

model PaymentAllocation {
  id          String   @id @default(cuid())
  paymentId   String
  documentId  String
  amount      BigInt
  allocatedAt DateTime @default(now())
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  document    Document @relation(fields: [documentId], references: [id])

  @@unique([paymentId, documentId])
  @@index([documentId])
}

model MoneyMovement {
  id             String                 @id @default(cuid())
  movementDate   DateTime
  direction      MoneyMovementDirection
  amount         BigInt
  accountId      String
  paymentId      String
  counterpartyId String?
  createdAt      DateTime               @default(now())
  account        Account                @relation(fields: [accountId], references: [id])
  payment        Payment                @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  counterparty   Counterparty?          @relation(fields: [counterpartyId], references: [id])

  @@index([accountId, movementDate])
  @@index([paymentId])
}

model AuditLog {
  id         String          @id @default(cuid())
  entityType AuditEntityType
  entityId   String
  action     AuditAction
  actor      String?
  payload    Json?
  createdAt  DateTime        @default(now())

  @@index([entityType, entityId, createdAt])
}

model PrintTemplate {
  id        String             @id @default(cuid())
  scope     PrintTemplateScope
  name      String
  version   Int
  isActive  Boolean            @default(true)
  html      String
  styles    String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  @@unique([scope, version])
  @@index([scope, isActive])
}
